{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/gate-result.schema.json",
  "title": "Gilfoyle final gate result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "specDigest", "stage", "decision", "classification", "eligibleRetry", "checks", "lifecycle", "acceptance", "summary"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "specDigest": {"$ref": "#/$defs/sha256"},
    "stage": {"const": "gate"},
    "decision": {"enum": ["NEEDS_WORK", "HALT_FALSIFIED", "NEEDS_DECISION", "ALL_GREEN"]},
    "classification": {"enum": ["none", "class-a", "class-b", "ambiguous"]},
    "eligibleRetry": {"type": "boolean"},
    "sliceKey": {"type": "string", "minLength": 1},
    "implicatedLeg": {"enum": ["impl", "oracle", "design", "substrate"]},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "NEEDS_WORK"}}}, "then": {"properties": {"classification": {"const": "class-a"}, "eligibleRetry": {"const": true}}, "required": ["sliceKey"]}},
    {"if": {"properties": {"decision": {"const": "ALL_GREEN"}}}, "then": {"properties": {"classification": {"const": "none"}, "eligibleRetry": {"const": false}}}},
    {"if": {"properties": {"decision": {"const": "HALT_FALSIFIED"}}}, "then": {"properties": {"classification": {"const": "class-b"}, "eligibleRetry": {"const": false}}, "required": ["implicatedLeg"]}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check": {"type": "object", "additionalProperties": false, "required": ["key", "kind", "status", "expected", "actual", "oracleActual"], "properties": {"key": {"type": "string", "minLength": 1}, "kind": {"enum": ["build", "unit", "stress", "oracle", "budget", "falsifier", "regression-fence"]}, "status": {"enum": ["pass", "fail"]}, "expected": {}, "actual": {}, "oracleActual": {}, "plannedFiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["runId", "childId", "state"], "properties": {"runId": {"type": "string", "minLength": 1}, "childId": {"type": "string", "minLength": 1}, "state": {"enum": ["complete", "failed", "paused"]}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["provenance", "passed"], "properties": {"provenance": {"enum": ["checked", "verified", "reviewed"]}, "passed": {"type": "boolean"}}}
  }
}
