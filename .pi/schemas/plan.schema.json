{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/plan.schema.json",
  "title": "Gilfoyle atomic slice plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "specDigest", "designDigest", "stage", "decision", "slices"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "specDigest": {"$ref": "#/$defs/sha256"},
    "designDigest": {"$ref": "#/$defs/sha256"},
    "stage": {"const": "plan"},
    "decision": {"enum": ["CONTINUE", "HALT_FALSIFIED", "NEEDS_DECISION"]},
    "slices": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/slice"}},
    "featureBudget": {"$ref": "#/$defs/featureBudget"},
    "deliveryIncrements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deliveryIncrement"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
    "commandCheck": {"type": "object", "additionalProperties": false, "required": ["expected"], "properties": {"command": {"type": "string", "minLength": 1}, "evidenceRef": {"type": "string", "minLength": 1}, "applicabilityReason": {"type": "string", "minLength": 1}, "expected": {}}, "anyOf": [{"required": ["command"]}, {"required": ["evidenceRef"]}], "dependentRequired": {"evidenceRef": ["applicabilityReason"]}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["key", "outcome", "changes", "files", "verification"], "properties": {"key": {"type": "string", "minLength": 1}, "claimKey": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "changes": {"type": "string", "minLength": 1}, "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}}, "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commandCheck"}}, "dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "featureBudget": {"type": "object", "additionalProperties": false, "required": ["scope", "production", "testsProof", "authority", "countingConvention"], "properties": {"scope": {"type": "string", "minLength": 1}, "production": {"type": "string", "minLength": 1}, "testsProof": {"type": "string", "minLength": 1}, "authority": {"enum": ["soft", "hard"]}, "countingConvention": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "exceeded": {"type": "boolean"}, "explanation": {"type": "string", "minLength": 1}, "authorizationRef": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"authority": {"const": "hard"}}}, "then": {"required": ["owner"]}}, {"if": {"properties": {"authority": {"const": "hard"}, "exceeded": {"const": true}}, "required": ["exceeded"]}, "then": {"required": ["authorizationRef"]}}, {"if": {"properties": {"authority": {"const": "soft"}, "exceeded": {"const": true}}, "required": ["exceeded"]}, "then": {"required": ["explanation"]}}]},
    "deliveryIncrement": {"type": "object", "additionalProperties": false, "required": ["name", "sliceKeys", "mergeableDefinition"], "properties": {"name": {"type": "string", "minLength": 1}, "sliceKeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "mergeableDefinition": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
