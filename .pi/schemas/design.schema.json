{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/design.schema.json",
  "title": "Gilfoyle falsifiable design",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "specDigest", "probeDigest", "stage", "decision", "placements", "claims"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "specDigest": {"$ref": "#/$defs/sha256"},
    "probeDigest": {"$ref": "#/$defs/sha256"},
    "stage": {"const": "design"},
    "decision": {"enum": ["CONTINUE", "HALT_FALSIFIED", "NEEDS_DECISION"]},
    "inputShapes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shape"}},
    "removedInvariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "placements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/claim"}},
    "negativeSpace": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval": {"$ref": "#/$defs/approval"},
    "trackerIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implicatedLeg": {"enum": ["impl", "oracle", "design", "substrate"]}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "CONTINUE"}}}, "then": {"required": ["approval"], "properties": {"claims": {"not": {"contains": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shape": {"type": "object", "additionalProperties": false, "required": ["key", "description", "coverage"], "properties": {"key": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}, "outOfScopeReason": {"type": "string", "minLength": 1}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["removedConstraint", "property", "coverage"], "properties": {"removedConstraint": {"type": "string", "minLength": 1}, "property": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["capability", "owner", "ownerRationale", "coverage"], "properties": {"capability": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "ownerRationale": {"type": "string", "minLength": 1}, "newSeam": {"const": true}, "interfaceDesign": {"type": "string", "minLength": 1}, "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "coverage": {"type": "string", "minLength": 1}}, "dependentRequired": {"newSeam": ["interfaceDesign"]}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["key", "statement", "falsifier", "status", "regressionCoverage"], "properties": {"key": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "falsifier": {"type": "string", "minLength": 1}, "oracle": {"$ref": "#/$defs/oracle"}, "namedMutation": {"$ref": "#/$defs/mutation"}, "status": {"enum": ["pending", "passed", "failed"]}, "regressionCoverage": {"type": "string", "minLength": 1}, "evidenceRef": {"type": "string", "minLength": 1}, "pendingOwner": {"type": "string", "minLength": 1}, "pendingStep": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"status": {"const": "pending"}}}, "then": {"required": ["pendingOwner", "pendingStep"]}}, {"if": {"properties": {"status": {"enum": ["passed", "failed"]}}}, "then": {"required": ["evidenceRef"]}}]},
    "oracle": {"type": "object", "additionalProperties": false, "required": ["gap", "independentMechanism", "protocol"], "properties": {"gap": {"type": "string", "minLength": 1}, "independentMechanism": {"type": "string", "minLength": 1}, "protocol": {"type": "string", "minLength": 1}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["gap", "defect", "codeChange", "expectedRed"], "properties": {"gap": {"type": "string", "minLength": 1}, "defect": {"type": "string", "minLength": 1}, "codeChange": {"type": "string", "minLength": 1}, "expectedRed": {"type": "string", "minLength": 1}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["confirmationText", "timestampUtc"], "properties": {"confirmationText": {"type": "string", "minLength": 1}, "timestampUtc": {"type": "string", "format": "date-time"}, "delegation": {"type": "string", "minLength": 1}}}
  }
}
