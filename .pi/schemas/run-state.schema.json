{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/run-state.schema.json",
  "title": "Gilfoyle authoritative run state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "featureSlug", "specDigest", "state", "iteration", "maxIterations", "createdAt", "updatedAt", "artifacts", "receiptDigests", "lifecycleRunIds"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1, "maxLength": 128},
    "featureSlug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "specDigest": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["SPEC_PENDING", "SIGNED", "PROBING", "DESIGNING", "PLANNING", "BUILDING", "GATING", "REVIEWING", "ALL_GREEN", "HALT_FALSIFIED", "NEEDS_DECISION"]},
    "currentStage": {"enum": ["spec", "probe", "design", "plan", "build", "gate", "review"]},
    "iteration": {"type": "integer", "minimum": 0, "maximum": 5},
    "maxIterations": {"const": 5},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "receiptDigests": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/sha256"}},
    "lifecycleRunIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminalReason": {"type": "string", "minLength": 1},
    "trackerId": {"type": "string", "minLength": 1},
    "headCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["ALL_GREEN", "HALT_FALSIFIED", "NEEDS_DECISION"]}}}, "then": {"required": ["terminalReason"]}},
    {"if": {"properties": {"state": {"const": "HALT_FALSIFIED"}, "iteration": {"const": 5}}}, "then": {"required": ["trackerId"]}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
