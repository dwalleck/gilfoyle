{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/specification.schema.json",
  "title": "Gilfoyle signed specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "featureSlug", "what", "roles", "behaviors", "successCriteria", "edgeDecisions", "outOfScope", "constraints", "decisions", "signoff"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1, "maxLength": 128},
    "featureSlug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "what": {"type": "string", "minLength": 1},
    "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedDescription"}},
    "behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/behavior"}},
    "successCriteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measuredCriterion"}},
    "edgeDecisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "outOfScope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/measuredCriterion"}},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationText", "timestampUtc", "unsignedPayloadSha256", "spotChecks"],
      "properties": {
        "confirmationText": {"type": "string", "minLength": 1},
        "timestampUtc": {"type": "string", "format": "date-time"},
        "unsignedPayloadSha256": {"$ref": "#/$defs/sha256"},
        "spotChecks": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/spotCheck"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "namedDescription": {"type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "behavior": {"type": "object", "additionalProperties": false, "required": ["name", "given", "when", "then"], "properties": {"name": {"type": "string", "minLength": 1}, "given": {"type": "string", "minLength": 1}, "when": {"type": "string", "minLength": 1}, "then": {"type": "string", "minLength": 1}}},
    "measuredCriterion": {"type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "measurement"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["number", "integer", "string"]}, "unit": {"type": "string", "minLength": 1}, "measurement": {"type": "string", "minLength": 1}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["question", "decision", "rationale"], "properties": {"question": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}},
    "spotCheck": {"type": "object", "additionalProperties": false, "required": ["question", "answer", "matchesDecision"], "properties": {"question": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1}, "matchesDecision": {"const": true}}}
  }
}
