{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gilfoyle.local/schemas/probe-result.schema.json",
  "title": "Gilfoyle probe result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "specDigest", "stage", "decision", "question", "sources", "learnedFact", "artifacts"],
  "properties": {
    "version": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "specDigest": {"$ref": "#/$defs/sha256"},
    "stage": {"const": "probe"},
    "decision": {"enum": ["CONTINUE", "HALT_FALSIFIED", "NEEDS_DECISION"]},
    "question": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "probe": {"$ref": "#/$defs/execution"},
    "oracle": {"allOf": [{"$ref": "#/$defs/execution"}, {"type": "object", "required": ["gap", "independentMechanism"]}]},
    "comparisons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/comparison"}},
    "agreement": {"type": "boolean"},
    "learnedFact": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "trackerIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implicatedLeg": {"enum": ["impl", "oracle", "design", "substrate"]}
  },
  "dependentRequired": {"oracle": ["comparisons", "agreement"], "comparisons": ["agreement"]},
  "allOf": [
    {"if": {"properties": {"decision": {"const": "CONTINUE"}}}, "then": {"properties": {"sources": {"not": {"contains": {"properties": {"status": {"enum": ["failed", "pending"]}}, "required": ["status"]}}}, "agreement": {"const": true}, "probe": {"properties": {"exitCode": {"const": 0}}}, "oracle": {"properties": {"exitCode": {"const": 0}}}, "comparisons": {"not": {"contains": {"properties": {"matches": {"const": false}}, "required": ["matches"]}}}}}},
    {"if": {"properties": {"decision": {"const": "HALT_FALSIFIED"}}}, "then": {"required": ["implicatedLeg"]}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["passed", "failed", "pending"]}, "reference": {"type": "string", "minLength": 1}, "sourceState": {"type": "string", "minLength": 1}, "inputs": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}, "applicabilityReason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "step": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"status": {"enum": ["passed", "failed"]}}}, "then": {"required": ["reference", "sourceState", "inputs", "environment", "result"]}}, {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"required": ["owner", "step"]}}]},
    "execution": {"type": "object", "additionalProperties": false, "required": ["command", "exitCode", "output"], "properties": {"command": {"type": "string", "minLength": 1}, "exitCode": {"type": "integer"}, "output": {}, "gap": {"type": "string", "minLength": 1}, "independentMechanism": {"type": "string", "minLength": 1}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["key", "expected", "actual", "matches"], "properties": {"key": {"type": "string", "minLength": 1}, "expected": {}, "actual": {}, "matches": {"type": "boolean"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
